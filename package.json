{
  "name": "scholarone-auto-reject",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install-browsers": "playwright install chromium",
    "test": "node --test",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "logs:prune": "node scripts/prune-logs.js",
    "fixtures:check": "node scripts/anonymize-fixtures.js --check",
    "ui": "node src/ui-server.js",
    "dryrun": "node src/auto-reject.js --headed --dry-run",
    "reject": "node src/auto-reject.js --headed --save-and-send",
    "reject:from-report": "node src/auto-reject.js --headed --save-and-send --require-targets",
    "screen-metadata": "node src/auto-reject.js --headed --collect-metadata",
    "screen-manuscript": "node src/auto-reject.js --headed --collect-metadata --assess-with-llm --scan-all-metadata",
    "screen-manuscript:live": "node src/auto-reject.js --headed --collect-metadata --assess-with-llm --apply-assessment-decisions",
    "eval:assessment-prompts": "node scripts/evaluate-assessment-prompts.js",
    "select-reviewers": "node src/scholarone.js --select-reviewers --headed",
    "select-reviewers:invite": "node src/scholarone.js --select-reviewers --headed --invite-all",
    "select-reviewers:resume": "node src/scholarone.js --select-reviewers --headed --resume-invite-reviewers",
    "select-reviewers:resume:invite": "node src/scholarone.js --select-reviewers --headed --resume-invite-reviewers --invite-all",
    "codegen": "playwright codegen https://mc.manuscriptcentral.com/kes"
  },
  "dependencies": {
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "eslint": "^10.8.0"
  }
}
